{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.soundza/soundza",
  "title": "Soundza",
  "description": "Free sound effects, music and ambience for games, videos and apps: search and download.",
  "version": "1.0.0",
  "websiteUrl": "https://soundza.com/developers?utm_source=mcp-registry&utm_medium=directory",
  "repository": { "url": "https://github.com/soundza/soundza-mcp", "source": "github" },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.soundza.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <your Soundza API key>. Free at https://soundza.com/developers/keys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    },
    { "type": "streamable-http", "url": "https://mcp.soundza.com/mcp/oauth" }
  ]
}
